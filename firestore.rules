rules_version = '2';

// Server-side protection for TypeSetu's Firestore data.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function shortString(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // Blocks rapid rewrites of the same document (minimum gap between updates).
    function notTooSoon(seconds) {
      return !('timestamp' in resource.data)
        || !(resource.data.timestamp is timestamp)
        || request.time > resource.data.timestamp + duration.value(seconds, 's');
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'lastLogin', 'name', 'siteName', 'displayName'])
        && shortString('name', 40)
        && shortString('siteName', 40)
        && shortString('displayName', 40)
        && shortString('email', 254);
      allow delete: if false;

      match /results/{resultId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && resultId.size() <= 64
          && request.resource.data.timestamp == request.time
          && request.resource.data.netWPM is number
          && request.resource.data.netWPM >= 0 && request.resource.data.netWPM <= 300;
        allow update: if isOwner(uid)
          && request.resource.data.timestamp == request.time
          && notTooSoon(2);
        allow delete: if isOwner(uid);
      }

      match /lessons/{lessonId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && lessonId.size() <= 64
          && request.resource.data.keys().hasOnly(['entries'])
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 10;
        allow delete: if isOwner(uid);
      }

      match /data/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && docId == 'revision'
          && request.resource.data.keys().hasOnly(['words', 'updatedAt'])
          && request.resource.data.words is list
          && request.resource.data.words.size() <= 5000;
      }
    }
  }
}
